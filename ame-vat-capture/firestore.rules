rules_version = '2';

// AME VAT Capture — Firestore security rules
// Model:
//   firms/{firmId}
//     members/{uid}              role: 'accountant' | 'client'
//     clients/{clientId}
//       receipts/{receiptId}
//       bankTransactions/{txnId}
//       vatSchedules/{periodId}
//     verifiedVendors/{vatNumber}
//
// Access model:
//   - Accountants (members with role == 'accountant') have full read/write
//     over everything under their firm.
//   - Clients (members with role == 'client') can only touch their own
//     client doc and the `receipts` subcollection beneath it. They can
//     create receipts and read their own, but cannot modify reviewed ones.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function memberDoc(firmId) {
      return get(/databases/$(database)/documents/firms/$(firmId)/members/$(request.auth.uid));
    }

    function isFirmMember(firmId) {
      return isSignedIn() && exists(
        /databases/$(database)/documents/firms/$(firmId)/members/$(request.auth.uid)
      );
    }

    function isAccountant(firmId) {
      return isFirmMember(firmId) && memberDoc(firmId).data.role == 'accountant';
    }

    function isClientUser(firmId, clientId) {
      return isFirmMember(firmId)
        && memberDoc(firmId).data.role == 'client'
        && memberDoc(firmId).data.clientId == clientId;
    }

    // Firm root — only accountants can read firm metadata
    match /firms/{firmId} {
      allow read: if isFirmMember(firmId);
      allow write: if isAccountant(firmId);

      // Members index: accountants manage members; anyone signed in reads
      // their own membership record (needed for the helper functions above
      // to work once the user logs in).
      match /members/{memberId} {
        allow read: if isSignedIn() && (request.auth.uid == memberId || isAccountant(firmId));
        allow write: if isAccountant(firmId);
      }

      // Verified SARS vendor cache — accountant-only writes, firm-wide read
      match /verifiedVendors/{vatNumber} {
        allow read: if isFirmMember(firmId);
        allow write: if isAccountant(firmId);
      }

      // Client records
      match /clients/{clientId} {
        allow read: if isAccountant(firmId) || isClientUser(firmId, clientId);
        allow create, update, delete: if isAccountant(firmId);

        // Receipts — clients can create/read their own; accountants full control
        match /receipts/{receiptId} {
          allow read: if isAccountant(firmId) || isClientUser(firmId, clientId);
          allow create: if isAccountant(firmId)
            || (isClientUser(firmId, clientId)
                && request.resource.data.status in ['pending', 'extracted']);
          allow update: if isAccountant(firmId)
            || (isClientUser(firmId, clientId)
                && resource.data.status in ['pending', 'extracted']
                && request.resource.data.status in ['pending', 'extracted']);
          allow delete: if isAccountant(firmId);
        }

        // Bank transactions — accountant only
        match /bankTransactions/{txnId} {
          allow read, write: if isAccountant(firmId);
        }

        // VAT schedules — accountant only
        match /vatSchedules/{periodId} {
          allow read, write: if isAccountant(firmId);
        }
      }
    }

    // Deny by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
